# Copy to .env and fill in. Never commit the real .env file.

# --- Sensor (EC2) ---
SENSOR_HOST=203.0.113.10
SENSOR_ADMIN_PORT=52222
SENSOR_SSH_USER=ubuntu
SENSOR_SSH_KEY=~/.ssh/secu-sensor.pem
SENSOR_COWRIE_LOG_PATH=/home/ubuntu/cowrie-data/cowrie.json

# --- Splunk (local Docker) ---
SPLUNK_HEC_URL=https://localhost:8088/services/collector
SPLUNK_HEC_TOKEN=replace-me
SPLUNK_INDEX=honeypot
SPLUNK_VERIFY_TLS=false

# --- Threat intel ---
ABUSEIPDB_API_KEY=replace-me
# GreyNoise intentionally omitted -- see docs/decisions/0005-threat-intel-sources.md

# --- AWS responder (respond.py) ---
AWS_REGION=us-east-1
AWS_PROFILE=secu-responder
RESPONDER_NACL_ID=acl-replace-me
RESPONDER_ALLOWLIST=203.0.113.99/32,10.90.0.0/16
RESPONDER_MAX_RULES=18
RESPONDER_BLOCK_TTL_HOURS=24
